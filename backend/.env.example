# ── Core ─────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017/nagarik_sahayak
DB_NAME=nagarik_sahayak
CORS_ORIGINS=http://localhost:3000
DEMO_MODE=false
ADMIN_SECRET=change_this_to_a_secure_secret

# ── Required before any personal data is stored ──────────────────────────
# Encrypts every personal-data column AND every generated document. Losing it
# makes both unrecoverable — by design, since a recovery path would be a second
# way in. Put it in a secret manager before running the migration scripts.
#   python scripts/encrypt_at_rest.py --generate-key
DATA_ENCRYPTION_KEY=
# Set only while rotating; the migration reads the old key and rewrites with
# the new one. Remove it once the rotation has finished.
DATA_ENCRYPTION_KEY_OLD=

# Salt for the one-way fingerprints that let duplicate claims be detected
# without storing the identifiers themselves. Changing it invalidates every
# stored fingerprint, so the backfill must be re-run.
#   python scripts/backfill_identity_index.py
IDENTITY_HASH_SALT=

# ── Grievance Officer (IT Rules 3(2), DPDP s8(7)) ────────────────────────
# These must be a real person who will answer. The Rules require an
# acknowledgement within 24 hours and resolution within 15 days; publishing a
# contact nobody monitors is worse than the statute's default, because the
# citizen believes someone is dealing with it.
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_PHONE=
GRIEVANCE_OFFICER_ADDRESS=

# ── Optional: language and LLM services ──────────────────────────────────
EMERGENT_LLM_KEY=your_emergent_llm_key_here
SARVAM_API_KEY=your_sarvam_api_key_here
AGNOST_WRITE_KEY=your_agnost_write_key_here

# ── KYC ──────────────────────────────────────────────────────────────────
# Aadhaar offline e-KYC and Secure QR work with none of these set. Without the
# UIDAI certificate the signature on an offline e-KYC file is parsed but not
# verified, and the result is reported at DOCUMENTED rather than VERIFIED
# assurance — the citizen is told so, and the record reaches a human reviewer.
# Path to a PEM certificate for UIDAI's signing key. Needs `signxml` installed.
UIDAI_SIGNING_CERT=

# Each block below switches on one method. Until its keys are set the method is
# listed in the UI as "not switched on" rather than hidden, so a citizen who was
# told to use it learns why they cannot.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
PENNY_DROP_API_URL=
PENNY_DROP_API_KEY=
PAN_VERIFY_API_URL=
PAN_VERIFY_API_KEY=
EPIC_VERIFY_API_URL=
EPIC_VERIFY_API_KEY=
DL_VERIFY_API_URL=
DL_VERIFY_API_KEY=
VIDEO_KYC_PROVIDER_URL=
VIDEO_KYC_API_KEY=

# Aadhaar OTP e-KYC and biometric authentication are NOT configurable here.
# They require appointment as a KUA/AUA by UIDAI, which no environment variable
# can substitute for. They stay marked "needs licence" until that is obtained.
