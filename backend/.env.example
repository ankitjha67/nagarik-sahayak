# Nagarik Sahayak backend configuration. Copy to .env and fill in.
# Secrets never go in images or source control; mount them at deploy time.

# ── Core ───────────────────────────────────────────────────────────────────
APP_ENV=development                 # production enables every hard check below
MONGO_URL=mongodb://127.0.0.1:27017/nagarik_sahayak?replicaSet=rs0
DB_NAME=nagarik_sahayak
CORS_ORIGINS=http://localhost:3000
DEMO_MODE=false                     # demo build only: fixed OTP, placeholder chat ids; ignored in production

# ── Authentication (backend/auth) ──────────────────────────────────────────
AUTH_JWT_SECRET=                    # required in production; ≥32 chars; signs access tokens
AUTH_ACCESS_TTL_MIN=30              # access token life, capped at 60
AUTH_REFRESH_TTL_DAYS=30            # refresh/session life, capped at 90
AUTH_ADMIN_PHONES=                  # comma-separated phones that sign in as admin (TOTP enforced)
AUTH_REVIEWER_PHONES=               # reviewers may read any citizen's case
AUTH_OPERATOR_PHONES=               # CSC/VLE operators act for citizens who recorded consent
AUTH_ADMIN_MFA=true
ADMIN_SECRET=                       # legacy admin header, also accepted as an admin principal

# One-time codes
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCK_SECONDS=900
OTP_MOCK_CODE=                      # fixed code for dev/test only; never honoured in production

# SMS delivery: log | msg91 | twilio | webhook
SMS_PROVIDER=log
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=                  # DLT-registered OTP template
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_WEBHOOK_URL=                    # POST {phone, message, code} to your own gateway
SMS_WEBHOOK_TOKEN=

# ── API edge (backend/api/middleware.py) ───────────────────────────────────
TRUSTED_PROXIES=                    # proxy IPs whose X-Forwarded-For is believed
MAX_JSON_BODY_BYTES=262144
MAX_UPLOAD_BODY_BYTES=26214400
API_RATE_LIMIT_PER_MINUTE=300       # per bearer token (or IP) token bucket
RATE_LIMIT_MAX=5                    # OTP requests per phone per window
RATE_LIMIT_WINDOW=60

# ── Data protection ────────────────────────────────────────────────────────
DATA_ENCRYPTION_KEY=                # profiles and documents at rest
IDENTITY_HASH_SALT=                 # keyed fingerprints for duplicate detection

# ── Speech to text (backend/stt) ───────────────────────────────────────────
# STT_PROVIDER=auto picks by language; or name one key from GET /api/stt/providers.
STT_PROVIDER=auto
STT_FALLBACKS=                      # comma-separated order to try, overrides the default chain
STT_STRICT=false                    # true: an explicitly requested provider never falls back
STT_MOCK_TEXT=                      # enables the mock engine outside demo builds

# Free / Government of India
BHASHINI_USER_ID=
BHASHINI_ULCA_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
# Free / local (optional packages: faster-whisper, vosk)
WHISPER_MODEL=small                 # tiny | base | small | medium | large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE=int8
VOSK_MODEL_PATH=
# Free / any OpenAI-compatible server you run (faster-whisper-server, speaches, LocalAI)
STT_COMPAT_BASE_URL=                # e.g. http://stt.internal:8000/v1
STT_COMPAT_API_KEY=
STT_COMPAT_MODEL=Systran/faster-whisper-small
# Hosted with free tiers
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GEMINI_API_KEY=
GEMINI_STT_MODEL=gemini-2.0-flash
# NVIDIA Riva / NIM ASR (self-hosted; audio stays on your infra)
NVIDIA_STT_BASE_URL=                # e.g. http://riva:9000/v1 (OpenAI-compatible audio)
NVIDIA_STT_MODEL=parakeet-1.1b
# Frontier, paid
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_MODEL=universal
GOOGLE_STT_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TRANSLATE_MODEL=saaras:v2.5
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1

# ── Text generation (backend/llm) ──────────────────────────────────────────
# Optional: only used to classify a form's fields from its text when the
# rule-based extractor is not enough. LLM_PROVIDER=auto tries them in order; or
# name one from GET /api/llm/providers. Set STT-style LLM_FALLBACKS to reorder.
LLM_PROVIDER=auto
LLM_FALLBACKS=
LLM_STRICT=false
LLM_MOCK_TEXT=                       # enables the mock provider (tests)
# NVIDIA NIM (hosted at integrate.api.nvidia.com, key nvapi-…; or self-hosted)
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_NIM_BASE_URL=                 # set to point at a self-hosted NIM
# OpenAI and OpenAI-compatible vendors
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
# Native-schema providers
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_MODEL=gemini-2.0-flash
COHERE_API_KEY=
COHERE_MODEL=command-r-plus
# Local / self-hosted
OLLAMA_BASE_URL=                     # e.g. http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
LLM_COMPAT_BASE_URL=                 # any OpenAI /chat/completions server (vLLM, TGI, LocalAI…)
LLM_COMPAT_API_KEY=
LLM_COMPAT_MODEL=local-model
# The key shipped with the project (Claude via emergentintegrations)
EMERGENT_LLM_KEY=
EMERGENT_PROVIDER=anthropic
EMERGENT_MODEL=claude-sonnet-4-20250514

# ── Optional integrations ──────────────────────────────────────────────────
AGNOST_WRITE_KEY=                   # analytics; leave empty under SOVEREIGN deployments
